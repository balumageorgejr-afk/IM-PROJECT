# ==============================================================================
# Campus Facility Management System - Environment Configuration
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the Express server (Render automatically injects PORT in production)
PORT=5000

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT bearer tokens.
# REQUIRED: Must be at least 32 bytes of secure random material (64+ hex characters).
# You can generate a random secret via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_bytes_64_hex_chars

# ------------------------------------------------------------------------------
# 3. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string URL for Prisma and pg driver.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>[?sslmode=...]
#
# Examples:
# - Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_facilities"
#
# - Render Managed PostgreSQL (Internal Connection String):
#   DATABASE_URL="postgresql://campus_admin:<password>@dpg-xxxxxx-a:5432/campus_facility_db"
#
# - Supabase PostgreSQL (Session Pooler):
#   DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=verify-full"
#
# NOTE: Do NOT add an 'options' parameter to the query string, as the app pins
# the server timezone to UTC via the adapter settings.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_facilities

# ------------------------------------------------------------------------------
# 4. Initial Administrator Provisioning (Optional, for npm run db:seed)
# ------------------------------------------------------------------------------
# Used by scripts/seed.js to bootstrap the first System Administrator account
# on a newly deployed or fresh database.
PROVISION_ADMIN_EMAIL=admin@campus.edu
PROVISION_ADMIN_FIRST_NAME=System
PROVISION_ADMIN_LAST_NAME=Administrator
# Password must have at least 15 characters and at most 72 UTF-8 bytes:
PROVISION_ADMIN_PASSWORD=AdminSecurePassword2026!

